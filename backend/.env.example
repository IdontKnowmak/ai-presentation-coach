# Copy this file to .env and fill in your own values. Never commit .env.
# Neon: replace the placeholder with the connection string from your Neon dashboard.
# Prefer the SQLAlchemy psycopg v3 scheme shown below.
DATABASE_URL=xxxxxxx

# Cloudflare Workers AI (create an API token with Workers AI permissions).
# Free plan includes 10,000 Neurons/day; monitor usage in the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
MAX_EXTRACTED_CHARS=60000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_TOKEN_MINUTES=60
# Google Cloud OAuth 2.0 Web client ID for Google Sign-In (same as VITE_GOOGLE_CLIENT_ID).
# Add local and deployed frontend origins as authorized JavaScript origins.
GOOGLE_CLIENT_ID=
